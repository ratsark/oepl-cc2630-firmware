# Build artifacts
build/
binaries/

# Vendor firmware dumps: needed locally for analysis, not ours to redistribute.
# See reference/README.md. stock_ccfg.bin is the 88-byte hardware config block
# and is kept — it is register values, not code.
reference/*.bin
reference/*.elf
!reference/stock_ccfg.bin

